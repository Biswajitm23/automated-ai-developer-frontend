# Copy to frontend/.env.local. Base URL of the Django API (no trailing slash).
# Use the same hostname as the frontend (http://localhost:3000 with
# http://localhost:8000). Mixing localhost and 127.0.0.1 makes the API a
# different site, so the browser does not send the session cookie and sign-in
# appears to fail.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
