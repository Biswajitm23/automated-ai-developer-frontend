# Copy to frontend/.env.local. Base URL of the Django API (no trailing slash).
# Use the same hostname as the frontend (http://localhost:3000 with
# http://localhost:8000). Mixing localhost and 127.0.0.1 makes the API a
# different site, so the browser does not send the session cookie and sign-in
# appears to fail.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Development only: serve endpoints the backend does not provide yet from the
# in-browser mock API (src/lib/mock) with fictional data. Sign-in, the session
# and roles always use the real backend. Ignored by production builds
# (`npm run build`), which never include the mock. Restart `npm run dev` after
# changing it.
NEXT_PUBLIC_USE_MOCK_API=false
